# OpenAI API key for the Assistant.
# NOTE: this is used directly from the browser (no backend), so the key is
# visible to anyone who can inspect the running app. Fine for personal/local
# use — route through a proxy before deploying publicly.
# After editing this file you must RESTART the dev server.
VITE_OPENAI_API_KEY=

# Optional: override the model (default: gpt-4o-mini)
VITE_OPENAI_MODEL=gpt-4o-mini

# --- Firebase (leave ALL blank to run in local-only mode with localStorage) ---
# Fill these from Firebase console → Project settings → Your apps → SDK config.
# Cross-device sync + Google sign-in turn on only when these are set.
# Restart the dev server after editing.
VITE_FIREBASE_API_KEY=AIzaSyCPvAeLb7RH2CQxvLzpBLrz_Ky7M5RnSTs
VITE_FIREBASE_AUTH_DOMAIN=my-todo-app-akil.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=my-todo-app-akil
VITE_FIREBASE_STORAGE_BUCKET=my-todo-app-akil.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=336987826576
VITE_FIREBASE_APP_ID=1:336987826576:web:2c740b150ce15bbe92ab15
VITE_SIRI_SHORTCUT_URL=https://www.icloud.com/shortcuts/79165d99fe7a4ae1960929aafdf7c329
