rules_version = '2';

// Each signed-in user can read/write only their own document tree under
// /users/{uid}. The app stores all data in the single doc /users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
